{
  "分类": {
    "护栏数据台账": {
      "说明": "事故台账。护栏唯一会增长的数据源，架构规则要从这里长出来",
      "该提交": true,
      "能动": true,
      "谁读它": "scripts/incidents.py、CI 的事故台账 job、复盘的人"
    },
    "护栏文档": {
      "说明": "护栏自己的说明文档（台账除外）",
      "该提交": true,
      "能动": true,
      "谁读它": "要维护护栏的人"
    },
    "护栏脚本": {
      "说明": "从 ledger-service 搬来的检查脚本。只用 Python 标准库，CI 里不装依赖",
      "该提交": true,
      "能动": false,
      "谁读它": "pre-commit 与 CI。**改动要回源仓改** —— 本仓改了下次搬迁会被覆盖"
    },
    "护栏规则": {
      "说明": "护栏的数据面：本仓专用的规则与清单。改规则不动脚本",
      "该提交": true,
      "能动": true,
      "谁读它": "scripts/ 下的各道检查"
    },
    "CLI 源码": {
      "说明": "四个 CLI（admin / merchant / token / payment）的 TypeScript 源码",
      "该提交": true,
      "能动": true,
      "谁读它": "tsc / vitest / 运行时"
    },
    "CLI 测试": {
      "说明": "四个 CLI 与 cli-core 的测试",
      "该提交": true,
      "能动": true,
      "谁读它": "vitest"
    },
    "共享包": {
      "说明": "packages/ 下被四个 CLI 共用的代码",
      "该提交": true,
      "能动": true,
      "谁读它": "各 CLI 的 import"
    },
    "契约": {
      "说明": "与后端的接口契约（错误码等），改它要两边同步",
      "该提交": true,
      "能动": true,
      "谁读它": "scripts/check-error-codes.mjs、各 CLI"
    },
    "构建产物": {
      "说明": "tsup 打出来的 dist/，不该进版本库",
      "该提交": false,
      "能动": true,
      "谁读它": "npm 发布"
    },
    "业务文档": {
      "说明": "四个 CLI 的用户文档与各自 README",
      "该提交": true,
      "能动": true,
      "谁读它": "使用 CLI 的人"
    },
    "工具生成": {
      "说明": "由工具自动生成/维护的文件，人不要手改（改了下次生成会被覆盖）",
      "该提交": true,
      "能动": false,
      "谁读它": "Kiro / GitNexus"
    },
    "运维脚本": {
      "说明": "发布、契约校验等手动执行的脚本",
      "该提交": true,
      "能动": true,
      "谁读它": "人手动执行 / npm scripts"
    },
    "工具约定": {
      "说明": "位置与文件名由工具决定，不能挪",
      "位置由工具决定": true,
      "该提交": true,
      "能动": false,
      "谁读它": "pre-commit / GitLab CI / npm / tsc / vitest"
    },
    "根配置": {
      "说明": "Node / TS 工具链的根配置与许可证",
      "该提交": true,
      "能动": true,
      "谁读它": "npm / tsc / tsup / vitest"
    }
  },
  "规则": [
    { "模式": "docs/harness/incidents.md", "分类": "护栏数据台账" },
    { "模式": "docs/harness/**", "分类": "护栏文档" },
    { "模式": "harness/*.md", "分类": "护栏文档" },
    { "模式": "harness/*.json", "分类": "护栏规则" },
    { "模式": "harness/*.sh", "分类": "护栏脚本" },
    { "模式": "scripts/check_*.py", "分类": "护栏脚本" },
    { "模式": "scripts/incidents.py", "分类": "护栏脚本" },
    { "模式": "scripts/**", "分类": "运维脚本" },
    { "模式": "apps/*/dist/**", "分类": "构建产物" },
    { "模式": "packages/*/dist/**", "分类": "构建产物" },
    { "模式": "apps/*/tests/**", "分类": "CLI 测试" },
    { "模式": "packages/*/tests/**", "分类": "CLI 测试" },
    { "模式": "apps/*/docs/**", "分类": "业务文档" },
    { "模式": "apps/*/README.md", "分类": "业务文档" },
    { "模式": "apps/*/src/**", "分类": "CLI 源码" },
    { "模式": "apps/**", "分类": "根配置" },
    { "模式": "packages/**", "分类": "共享包" },
    { "模式": "contracts/**", "分类": "契约" },
    { "模式": "doc/**", "分类": "业务文档" },
    { "模式": "README.md", "分类": "业务文档" },
    { "模式": "AGENTS.md", "分类": "工具生成" },
    { "模式": "CLAUDE.md", "分类": "工具生成" },
    { "模式": "SKILL.md", "分类": "工具生成" },
    { "模式": ".claude/**", "分类": "工具生成" },
    { "模式": ".pre-commit-config.yaml", "分类": "工具约定" },
    { "模式": ".gitlab-ci.yml", "分类": "工具约定" },
    { "模式": ".github/**", "分类": "工具约定" },
    { "模式": "package.json", "分类": "根配置" },
    { "模式": "package-lock.json", "分类": "根配置" },
    { "模式": "tsconfig*.json", "分类": "根配置" },
    { "模式": "tsup.config.ts", "分类": "根配置" },
    { "模式": "vitest.config.ts", "分类": "根配置" },
    { "模式": ".gitignore", "分类": "根配置" },
    { "模式": ".gitleaksignore", "分类": "根配置" },
    { "模式": "LICENSE", "分类": "根配置" }
  ],
  "备注": "**规则有序，第一条命中为准** —— 所以顺序上：台账在 docs/harness/** 之前、护栏脚本在 scripts/** 之前、dist/ 在 apps/*/src/** 之前、apps/*/src/** 在 apps/** 之前。反着写会归错，而 layout-check 只查「归不进去」不查「归错」，归错永远不报。\n\n「工具约定」这一类声明了「位置由工具决定」，其中不含通配符的路径**必须真实存在**，所以刻意没写还不存在的文件。"
}
